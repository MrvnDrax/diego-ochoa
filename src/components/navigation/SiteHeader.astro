---
import BrandLogo from '@components/brand/BrandLogo.astro';
import WhatsAppIcon from '@components/brand/WhatsAppIcon.astro';
import MobileMenu from '@components/navigation/MobileMenu.astro';
import Button from '@components/ui/Button.astro';
import Container from '@components/ui/Container.astro';
import { mainNavigation } from '@data/navigation';
import { generalWhatsAppHref } from '@data/whatsapp-messages';

interface Props {
  currentPath?: string;
}
const { currentPath = Astro.url.pathname }: Props = Astro.props;
function isCurrentPath(href: string): boolean {
  return href === '/'
    ? currentPath === '/'
    : currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
  <MobileMenu currentPath={currentPath} />
  <div class="site-header__desktop">
    <Container class="site-header__container">
      <a
        class="site-header__brand"
        href="/"
        aria-label="Diego Ochoa, ir al inicio"
      >
        <BrandLogo variant="compact" tone="color" withSpecialty />
      </a>
      <nav class="site-header__navigation" aria-label="Navegación principal">
        <ul class="site-header__list">
          {mainNavigation.map((item) => {
            const isCurrent = isCurrentPath(item.href);
            return (
              <li>
                <a
                  class:list={[
                    'site-header__link',
                    { 'site-header__link--current': isCurrent },
                  ]}
                  href={item.href}
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  {item.shortLabel ?? item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
      <div class="site-header__cta">
        <Button
          href={generalWhatsAppHref}
          variant="primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsAppIcon slot="icon-start" />
          Consultar
        </Button>
      </div>
    </Container>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 100;
    top: 0;
    width: 100%;
  }
  .site-header__desktop {
    display: none;
    background: #fff;
    border-bottom: 1px solid #dce5ed;
  }
  .site-header__container {
    display: flex;
    min-height: 6rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
  }
  .site-header__brand {
    display: flex;
    flex: none;
    align-items: center;
    padding-block: 0.75rem;
    color: #1b325f;
    text-decoration: none;
  }
  .site-header__brand :global(.brand-logo--compact) {
    padding: 0;
    width: auto;
  }
  .site-header__navigation {
    min-width: 0;
  }
  .site-header__list {
    display: flex;
    align-items: center;
    gap: clamp(0.875rem, 1.5vw, 1.5rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .site-header__link {
    position: relative;
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    color: #34445e;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease;
  }
  .site-header__link::after {
    position: absolute;
    right: 0;
    bottom: 0.25rem;
    left: 0;
    height: 2px;
    background: #f26c4f;
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 160ms ease;
  }
  .site-header__link:hover,
  .site-header__link--current {
    color: #1b325f;
  }
  .site-header__link:hover::after,
  .site-header__link--current::after {
    transform: scaleX(1);
  }
  .site-header__cta {
    flex: none;
  }
  .site-header__cta :global(.button) {
    min-width: 10.5rem;
    min-height: 3rem;
    padding-inline: 1.125rem;
    border-radius: var(--radius-md);
    background: var(--color-action-whatsapp);
    color: var(--color-text-on-coral);
    font-weight: var(--font-weight-bold);
  }
  .site-header__cta :global(.button:hover) {
    background: var(--color-action-whatsapp-hover);
  }
  @media (min-width: 75rem) {
    .site-header__desktop {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__link,
    .site-header__link::after {
      transition: none;
    }
  }
</style>
