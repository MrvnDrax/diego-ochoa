---
import BrandLogo from '@components/brand/BrandLogo.astro';
import WhatsAppIcon from '@components/brand/WhatsAppIcon.astro';
import Icon from '@components/ui/Icon.astro';
import { doctoraliaProfile } from '@data/booking';
import { contact } from '@data/contact';
import { locations } from '@data/locations';
import { mainNavigation } from '@data/navigation';
import { socialLinks } from '@data/social-links';
import { generalWhatsAppHref } from '@data/whatsapp-messages';
import instagramIcon from '@assets/social/instagram.svg';
import facebookIcon from '@assets/social/facebook.svg';
import tiktokIcon from '@assets/social/tiktok.svg';
import youtubeIcon from '@assets/social/youtube.svg';
interface Props {
  doctorName?: string;
  developerName?: string;
}
const {
  doctorName = 'Diego Enrique Pérez Ochoa',
  developerName = 'emeza.dev',
}: Props = Astro.props;
const currentYear = new Date().getFullYear();
const socialIcons = {
  instagram: instagramIcon,
  facebook: facebookIcon,
  tiktok: tiktokIcon,
  youtube: youtubeIcon,
};
---

<footer class="site-footer">
  <div class="container site-footer__container">
    <div class="site-footer__main">
      <div class="site-footer__identity">
        <div>
          <a
            class="site-footer__brand"
            href="/"
            aria-label="Diego Ochoa, ir al inicio"
          >
            <BrandLogo variant="compact" tone="inverse" />
          </a>
          <p class="site-footer__specialty">
            Gestiones inmobiliarias
            <br />
            Tabasco · Chiapas · Veracruz
          </p>
          <a
            class="site-footer__profile"
            href={doctoraliaProfile.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            Escribir por WhatsApp
          </a>
        </div>
        <div class="site-footer__contact">
          <a
            class="site-footer__booking"
            href={generalWhatsAppHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            <WhatsAppIcon />
            Consultar una gestión
          </a>
          <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
          <a href="/contacto">Más opciones de contacto</a>
        </div>
      </div>
      <section
        class="site-footer__locations"
        aria-labelledby="footer-locations-heading"
      >
        <h2 id="footer-locations-heading">Dónde comenzar</h2>
        <ul>
          {locations.map((location) => (
            <li>
              <span class="site-footer__location-icon" aria-hidden="true">
                <Icon name="map-pin" size="small" />
              </span>
              <a
                href={location.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Ver ${location.facilityName} en Google Maps`}
              >
                <span>
                  <strong>{location.area}</strong>
                  <span>{location.facilityName}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a class="site-footer__all-locations" href="/ubicaciones">
          Ver opciones de atención
        </a>
      </section>
      <div class="site-footer__explore">
        <nav aria-labelledby="footer-navigation-heading">
          <h2 id="footer-navigation-heading">Información para ti</h2>
          <ul>
            {mainNavigation.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav class="site-footer__social" aria-label="Canales de Diego Ochoa">
          <h2>Canales disponibles</h2>
          <div>
            {socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Abrir ${link.label}: ${link.handle}`}
                title={link.label}
              >
                <img
                  src={socialIcons[link.platform].src}
                  alt=""
                  width="26"
                  height="26"
                />
              </a>
            ))}
          </div>
        </nav>
      </div>
    </div>
    <div class="site-footer__legal">
      <p>
        © {currentYear} {doctorName}.
      </p>
      <div>
        <a href="/aviso-de-privacidad">Aviso de privacidad</a>
        <button type="button" data-consent-settings hidden>
          Configurar privacidad
        </button>
      </div>
      <p>
        Diseño y desarrollo por{' '}
        <a
          class="site-footer__credit"
          href="https://emeza.dev"
          target="_blank"
          rel="noopener noreferrer"
        >
          {developerName}
        </a>
      </p>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    background: #1b325f;
    color: #e9f2f9;
    padding-inline: var(--home-ad-gutter, 0px);
  }
  .site-footer__container {
    padding-block: 3.5rem 1.5rem;
  }
  .site-footer__main {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    align-items: start;
  }
  .site-footer__identity {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }
  .site-footer__brand {
    display: inline-flex;
    max-width: 100%;
    text-decoration: none;
  }
  .site-footer__brand :global(.brand-logo--compact) {
    padding: 0;
    width: auto;
  }
  .site-footer__specialty {
    font-size: 1rem;
    line-height: 1.6;
    margin-top: 0.75rem;
    color: #c8d9ea;
  }
  .site-footer__profile {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    text-underline-offset: 0.25em;
    min-height: 2rem;
    color: #a9d9ff;
    text-decoration: underline;
  }
  .site-footer__contact {
    display: grid;
    justify-items: start;
    gap: 0.4rem;
  }
  .site-footer__contact > a {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.25rem;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
    max-width: 100%;
  }
  .site-footer__contact > a :global(svg) {
    flex: none;
  }
  .site-footer__contact > .site-footer__booking {
    display: inline-flex;
    justify-content: center;
    gap: 0.65rem;
    min-height: 3.25rem;
    border-radius: var(--radius-md);
    background: var(--color-action-whatsapp);
    color: var(--color-text-on-coral);
    padding: 0.8rem 1rem;
    margin-bottom: 0.6rem;
    font-weight: 700;
  }
  .site-footer__booking :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .site-footer__contact > .site-footer__booking:hover {
    background: var(--color-action-whatsapp-hover);
    text-decoration: none;
  }
  .site-footer h2 {
    font-family: var(--font-family-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    color: #fff;
    margin: 0 0 1.1rem;
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .site-footer__locations ul {
    gap: 0.75rem;
  }
  .site-footer__locations li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .site-footer__location-icon {
    display: grid;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    color: #9cc4e4;
    place-items: center;
  }
  .site-footer__locations li > a {
    display: block;
    color: #a9d9ff;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .site-footer__locations li > a > span {
    display: grid;
    gap: 0.25rem;
  }
  .site-footer__locations strong {
    color: #bfe1ff;
    font-weight: 600;
  }
  .site-footer__locations li > a > span > span {
    color: #a9d9ff;
    font-size: 0.875rem;
  }
  .site-footer__all-locations {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 1.5rem;
    min-height: 2rem;
    font-size: 0.875rem;
    text-underline-offset: 0.25em;
  }
  .site-footer__explore {
    display: grid;
    gap: 1.75rem;
  }
  .site-footer__explore li > a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    font-size: 0.9375rem;
    text-decoration: none;
    color: #c8d9ea;
  }
  .site-footer__social > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .site-footer__social a {
    display: grid;
    width: 3rem;
    height: 3rem;
    padding: 0.55rem;
    border: 1px solid #9cc4e470;
    border-radius: var(--radius-md);
    background: #fff;
    place-items: center;
    transition:
      transform 180ms ease-out,
      background-color 180ms ease-out;
  }
  .site-footer__social a:hover {
    transform: translateY(-2px);
    background: #e9f2f9;
  }
  .site-footer__social img {
    width: 1.625rem;
    height: 1.625rem;
    object-fit: contain;
  }
  .site-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .site-footer a:focus-visible,
  .site-footer button:focus-visible {
    outline-color: #9cc4e4;
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #9cc4e438;
    color: #c8d9ea;
    font-size: 0.8125rem;
    line-height: 1.65;
  }
  .site-footer__legal > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }
  .site-footer__legal a,
  .site-footer__legal button {
    color: inherit;
    text-underline-offset: 0.25em;
  }
  .site-footer__legal button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .site-footer__legal .site-footer__credit {
    font-weight: 600;
    color: #a9d9ff;
    text-decoration: underline;
  }
  @media (min-width: 40rem) and (max-width: 74.99rem) {
    .site-footer__main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .site-footer__identity {
      grid-column: 1/-1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }
  @media (min-width: 75rem) {
    .site-footer__main {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 0.85fr);
      gap: clamp(2rem, 4vw, 3rem);
    }
  }
  @media (max-width: 39.99rem) {
    .site-footer__container {
      padding-top: 2.5rem;
      padding-bottom: calc(2.5rem + env(safe-area-inset-bottom));
    }
    .site-footer__main {
      gap: 2rem;
    }
    .site-footer__contact > .site-footer__booking {
      width: 100%;
    }
    .site-footer__locations,
    .site-footer__explore {
      border-top: 1px solid rgb(156 196 228 / 28%);
      padding-top: 1.5rem;
    }
    .site-footer__locations ul {
      gap: 0.5rem;
    }
    .site-footer__locations li > a {
      padding: 0.75rem 0;
    }
    .site-footer__locations li {
      padding: 0 0.75rem;
      border: 1px solid rgb(156 196 228 / 28%);
      border-radius: var(--radius-md);
    }
    .site-footer__social {
      grid-column: 1 / -1;
    }
    .site-footer__legal {
      display: grid;
      gap: 0.75rem;
    }
    .site-footer__explore {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
