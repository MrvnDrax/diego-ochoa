---
interface Props {
  src: string;
  title: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { src, title, loading = 'lazy', class: className }: Props = Astro.props;

const embedUrl = new URL(src);

const isAllowedGoogleMapsUrl =
  embedUrl.protocol === 'https:' &&
  embedUrl.hostname === 'www.google.com' &&
  embedUrl.pathname === '/maps/embed';

if (!isAllowedGoogleMapsUrl) {
  throw new Error('GoogleMapEmbed solo admite URLs oficiales de Google Maps.');
}
---

<div class:list={['google-map', className]}>
  <iframe
    class="google-map__frame"
    src={embedUrl.toString()}
    title={title}
    loading={loading}
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
</div>

<style>
  .google-map {
    width: 100%;
    height: 10.625rem;
    overflow: hidden;
    background-color: var(--color-background-subtle);
  }

  .google-map__frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
