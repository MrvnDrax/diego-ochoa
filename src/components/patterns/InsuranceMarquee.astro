---
import InsuranceLogo from '@components/brand/InsuranceLogoImage.astro';

import { insurers } from '@data/insurers';

const desktopRows = [insurers, [...insurers].reverse()] as const;
---

<div class="insurance-marquee">
  <ul
    class="insurance-marquee__grid"
    aria-label="Pasos de orientación para tu gestión inmobiliaria"
  >
    {insurers.map((insurer) => (
      <li class="insurance-marquee__tile">
        <InsuranceLogo insurer={insurer.id} label={insurer.label} />
      </li>
    ))}
  </ul>

  <div class="insurance-marquee__desktop" aria-hidden="true">
    {desktopRows.map((row, rowIndex) => (
      <div class="insurance-marquee__viewport">
        <div
          class:list={[
            'insurance-marquee__track',
            rowIndex === 1 && 'insurance-marquee__track--reverse',
          ]}
        >
          {[...row, ...row].map((insurer) => (
            <div class="insurance-marquee__tile">
              <InsuranceLogo insurer={insurer.id} label={insurer.label} />
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .insurance-marquee {
    width: 100%;
    min-width: 0;
  }
  .insurance-marquee__grid {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .insurance-marquee__desktop {
    display: grid;
    gap: var(--spacing-4);
  }
  .insurance-marquee__viewport {
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 5%,
      #000 95%,
      transparent
    );
  }
  .insurance-marquee__viewport:nth-child(2) {
    display: none;
  }
  .insurance-marquee__track {
    display: flex;
    width: max-content;
    gap: var(--spacing-4);
    animation: insurance-marquee-forward 46s linear infinite;
    will-change: transform;
  }
  .insurance-marquee__tile {
    display: grid;
    width: 13rem;
    height: 5rem;
    flex: none;
    padding: var(--spacing-2);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    background: var(--color-background-canvas);
    place-items: center;
  }
  .insurance-marquee__tile :global(.guidance-step) {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.55rem;
    color: #1b325f;
    font-size: 0.82rem;
    line-height: 1.25;
    font-weight: 700;
  }
  .insurance-marquee__tile :global(.guidance-step__icon) {
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    border-radius: 50%;
    background: #e9f2f9;
    color: #32628e;
    place-items: center;
  }
  .insurance-marquee__tile :global(.guidance-step__icon svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  @media (min-width: 75rem) {
    .insurance-marquee__viewport:nth-child(2) {
      display: block;
    }
    .insurance-marquee__track--reverse {
      animation-name: insurance-marquee-reverse;
    }
  }
  @keyframes insurance-marquee-forward {
    to {
      transform: translateX(calc(-50% - var(--spacing-2)));
    }
  }
  @keyframes insurance-marquee-reverse {
    from {
      transform: translateX(calc(-50% - var(--spacing-2)));
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .insurance-marquee__track {
      animation: none;
    }
  }
</style>
