---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import doctoraliaSymbol from '@assets/diego/home-interior.png';
import rosarioPortrait from '@assets/diego/home-interior.png';
import areliPortrait from '@assets/diego/property-and-land.png';
import armandoPortrait from '@assets/diego/property-consultation.png';
import TestimonialCard from '@components/cards/TestimonialCard.astro';
interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  description?: string;
  sourceHref?: string;
  class?: string;
}
const {
  id = 'opiniones',
  eyebrow = 'Situaciones frecuentes',
  heading = 'Decisiones que merecen claridad',
  description = 'Ejemplos de temas que podemos revisar contigo. No son testimonios de clientes.',
  sourceHref = '/servicios/',
  class: className,
}: Props = Astro.props;
const testimonials = (await getCollection('testimonials'))
  .filter((t) => t.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const portraits = {
  'rosario-hoil': rosarioPortrait,
  'areli-perez': areliPortrait,
  'armando-rivas': armandoPortrait,
};
---

<section
  id={id}
  class:list={['patient-reviews', className]}
  aria-labelledby="patient-reviews-heading"
>
  <div class="container patient-reviews__layout">
    <header class="patient-reviews__intro">
      <p class="patient-reviews__eyebrow">{eyebrow}</p>
      <h2 id="patient-reviews-heading">{heading}</h2>
      <p class="patient-reviews__description">{description}</p>
      <a
        class="patient-reviews__source"
        href={sourceHref}
        
      >
        <Image src={doctoraliaSymbol} alt="" width={28} height={28} />
        <span>
          Conocer los servicios
        </span>
      </a>
      <p class="patient-reviews__note">
        Estos ejemplos son orientativos. Cada inmueble, crédito y gestión tiene requisitos propios.
      </p>
    </header>
    <div class="patient-reviews__list">
      {testimonials.map((t) => (
        <TestimonialCard
          quote={t.data.quote}
          rating={t.data.rating}
          author={t.data.authorDisplay}
          portrait={portraits[t.data.portrait]}
          publishedAt={'Caso orientativo'}
          
          location={t.data.sourceLocation}
          sourceHref={t.data.sourceUrl}
        />
      ))}
    </div>
  </div>
</section>
<style>
  .patient-reviews {
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    background: #f5f8fb;
    color: #1b325f;
  }
  .patient-reviews__layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .patient-reviews__intro {
    max-width: 27rem;
  }
  .patient-reviews__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-weight: 600;
    color: #37648c;
    margin-bottom: 1rem;
  }
  h2 {
    font-size: clamp(2rem, 3vw, 2.9rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .patient-reviews__description {
    font-size: 1rem;
    line-height: 1.7;
    color: #53677d;
    margin-top: 1.2rem;
  }
  .patient-reviews__source {
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.8rem;
    min-height: 44px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
  .patient-reviews__source:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .patient-reviews__source :global(img) {
    width: 28px;
    height: 28px;
    object-fit: contain;
    flex: none;
  }
  .patient-reviews__note {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #53677d;
    margin-top: 1rem;
    max-width: 26rem;
  }
  .patient-reviews__list {
    min-width: 0;
    background: #fff;
    padding: 0 clamp(1.25rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
  }
  .patient-reviews__list :global(.testimonial-card + .testimonial-card) {
    border-top: 1px solid #e2e9f0;
  }
  @media (min-width: 56rem) {
    .patient-reviews__layout {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
    .patient-reviews__intro {
      padding-top: 1.5rem;
    }
  }
</style>
