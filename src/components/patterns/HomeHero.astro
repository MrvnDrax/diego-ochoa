---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import portrait from '@assets/diego/diego-ochoa-portrait.png';
import WhatsAppIcon from '@components/brand/WhatsAppIcon.astro';
import Icon from '@components/ui/Icon.astro';
import { generalWhatsAppHref } from '@data/whatsapp-messages';
interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  description?: string;
  whatsappHref?: string;
  doctorHref?: string;
  certification?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  class?: string;
}
const {
  id = 'inicio',
  eyebrow = 'Gestiones inmobiliarias · Tabasco, Chiapas y Veracruz',
  whatsappHref = generalWhatsAppHref,
  doctorHref = '/diego-ochoa',
  certification = 'Orientación en bienes raíces',
  image = portrait,
  imageAlt = 'Diego Ochoa, abogado enfocado en bienes raíces',
  class: className,
}: Props = Astro.props;
---

<section
  id={id}
  class:list={['home-hero', className]}
  aria-labelledby="home-heading"
>
  <div class="home-hero__grid container">
    <div class="home-hero__content">
      <p class="home-hero__eyebrow">
        <span></span>
        {eyebrow}
      </p>
      <p class="home-hero__name">Diego Ochoa</p>
      <h1 id="home-heading">
        Tu patrimonio.
        <br />
        Tu decisión.
        <br />
        <em>Con más claridad.</em>
      </h1>
      <p class="home-hero__description">
        Orientación en bienes raíces para entender tus opciones, ordenar documentos y avanzar con información clara.
      </p>
      <div class="home-hero__actions">
        <a
          class="home-hero__booking"
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsAppIcon />
          Consultar mi caso
        </a>
        <a class="home-hero__profile" href={doctorHref}>
          Conoce a Diego <Icon name="arrow-right" size="small" />
        </a>
      </div>
      <p class="home-hero__locations">
        <Icon name="map-pin" size="small" />
        Tabasco · Chiapas · Veracruz
      </p>
    </div>
    <figure class="home-hero__portrait">
      <Image
        src={image}
        alt={imageAlt}
        widths={[440, 660, 900]}
        sizes="(max-width: 767px) 92vw, 45vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <span>Abogado enfocado en bienes raíces</span>
        <strong>Diego Enrique Pérez Ochoa</strong>
      </figcaption>
      <div class="home-hero__certification">
        <Icon name="check" size="medium" />
        <div>
          <strong>Área de atención</strong>
          <span>{certification}</span>
        </div>
      </div>
    </figure>
  </div>
</section>
<style>
  .home-hero {
    border-radius: var(--radius-xl);
    background: #f7fafc;
    color: #1b325f;
    overflow: hidden;
  }
  .home-hero__grid {
    display: grid;
    gap: 2rem;
    padding-block: 2.5rem;
    align-items: center;
  }
  .home-hero__content {
    min-width: 0;
  }
  .home-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    color: #4a6380;
  }
  .home-hero__eyebrow span {
    width: 1.6rem;
    height: 2px;
    background: #f26c4f;
    flex: none;
  }
  .home-hero__name {
    font-weight: 600;
    font-size: 1.12rem;
    margin-bottom: 0.8rem;
  }
  h1 {
    font-family: var(--font-family-heading);
    font-weight: 500;
    font-size: clamp(2.7rem, 4.3vw, 4.8rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    margin: 0;
  }
  h1 em {
    font-weight: 400;
    color: #37648c;
  }
  .home-hero__description {
    max-width: 31rem;
    font-size: 1.07rem;
    line-height: 1.65;
    color: #53677d;
    margin-top: 1.5rem;
  }
  .home-hero__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 1.7rem;
  }
  .home-hero__booking {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 0.95rem 1.2rem;
    min-height: 52px;
    background: var(--color-action-whatsapp);
    border: 1px solid var(--color-action-whatsapp);
    border-radius: var(--radius-md);
    color: var(--color-text-on-coral);
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s;
  }
  .home-hero__booking:hover {
    background: var(--color-action-whatsapp-hover);
  }
  .home-hero__booking :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .home-hero__profile {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #9cc4e4;
    padding: 0.6rem 0;
  }
  .home-hero__locations {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: #53677d;
    margin-top: 1.2rem;
    line-height: 1.5;
  }
  .home-hero__locations :global(svg) {
    flex: none;
  }
  .home-hero__portrait {
    position: relative;
    margin: 0;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: #e9f2f9;
  }
  .home-hero__portrait > :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4/4.7;
    object-fit: cover;
    object-position: 50% 32%;
    display: block;
  }
  figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem 1.35rem 1.2rem;
    color: white;
    background: linear-gradient(transparent, rgba(20, 40, 68, 0.92));
    display: grid;
    gap: 0.2rem;
  }
  figcaption span {
    font-size: 0.75rem;
    letter-spacing: 0.025em;
  }
  figcaption strong {
    font-weight: 600;
    font-size: 1rem;
  }
  .home-hero__certification {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    width: fit-content;
    max-width: calc(100% - 2rem);
    background: rgba(255, 255, 255, 0.96);
    padding: 0.75rem 0.9rem;
    box-shadow: 0 8px 30px #1b325f0c;
    border-left: 3px solid #3a89c9;
  }
  .home-hero__certification div {
    display: grid;
    gap: 0.1rem;
  }
  .home-hero__certification strong {
    font-size: 0.74rem;
    font-weight: 600;
  }
  .home-hero__certification span {
    font-size: 0.7rem;
    color: #53677d;
  }
  @media (min-width: 48rem) {
    .home-hero__grid {
      grid-template-columns: 1.08fr 1fr;
      gap: clamp(2rem, 4vw, 4rem);
      padding-block: 3rem;
    }
    .home-hero__portrait > :global(img) {
      aspect-ratio: 4/5;
      max-height: 560px;
    }
  }
  @media (max-width: 79.99rem) {
    .home-hero__portrait {
      display: flex;
      max-width: 34rem;
      flex-direction: column;
    }
    .home-hero__portrait figcaption {
      position: static;
      padding: 0.875rem 1rem;
      background: #1b325f;
    }
    .home-hero__certification {
      position: static;
      width: 100%;
      max-width: none;
      box-shadow: none;
      border-left: 0;
      border-top: 3px solid #3a89c9;
    }
  }
  @media (max-width: 47.99rem) {
    .home-hero__portrait > :global(img) {
      aspect-ratio: 5/4;
      object-position: 50% 25%;
    }
    .home-hero__booking {
      width: 100%;
    }
    .home-hero__actions {
      gap: 0.5rem;
    }
    .home-hero__profile {
      margin: auto;
    }
  }
</style>
