---
import Icon from '@components/ui/Icon.astro';

import { locations, primaryLocationId } from '@data/locations';
import { createLocationWhatsAppHref } from '@data/whatsapp-messages';

interface Props {
  id?: string;
  standalone?: boolean;
}

const { id = 'location-explorer', standalone = false }: Props = Astro.props;

const initialLocation =
  locations.find((location) => location.id === primaryLocationId) ??
  locations[0];

if (!initialLocation) {
  throw new Error('LocationExplorer necesita al menos una ubicación.');
}

const panelId = `${id}-panel`;
---

<section
  id={id}
  class:list={[
    'location-explorer',
    standalone && 'location-explorer--standalone',
  ]}
  data-location-explorer
>
  <div class="location-explorer__shell">
    <div
      class="location-explorer__tabs"
      role="tablist"
      aria-label="Seleccionar estado"
    >
      {locations.map((location) => {
        const isSelected = location.id === initialLocation.id;

        const isPrimary = location.id === primaryLocationId;

        const tabId = `${id}-tab-${location.id}`;

        return (
          <button
            id={tabId}
            class:list={[
              'location-explorer__tab',
              isSelected && 'location-explorer__tab--active',
            ]}
            type="button"
            role="tab"
            aria-selected={isSelected}
            aria-controls={panelId}
            tabindex={isSelected ? 0 : -1}
            data-location-tab
            data-location-id={location.id}
            data-location-area={location.area}
            data-location-display-name={location.displayName}
            data-location-address-value={location.addressDisplay}
            data-location-map-url={location.mapUrl}
            data-location-map-embed-url={location.mapEmbedUrl}
            data-location-whatsapp-url={createLocationWhatsAppHref(
              location.area,
            )}
            data-location-primary={isPrimary ? 'true' : 'false'}
          >
            <Icon
              name="map-pin"
              responsive
              strokeWidth={2}
              class="location-explorer__tab-icon"
            />

            <span>{location.area}</span>
          </button>
        );
      })}
    </div>

    <div
      id={panelId}
      class="location-explorer__card"
      role="tabpanel"
      aria-labelledby={`${id}-tab-${initialLocation.id}`}
      data-location-panel
    >
      <div class="location-explorer__map">
        <div
          class="location-explorer__loader"
          role="status"
          aria-live="polite"
          hidden
          data-location-loader
        >
          <span
            class="location-explorer__loader-spinner"
            aria-hidden="true"
          ></span>
          <span>Actualizando mapa</span>
        </div>
        <iframe
          class="location-explorer__map-frame"
          src={initialLocation.mapEmbedUrl}
          title={`Mapa de ${initialLocation.displayName}`}
          loading="lazy"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
          data-location-map-frame
        ></iframe>
      </div>

      <div class="location-explorer__details">
        <div class="location-explorer__header">
          <span
            class="location-explorer__badge"
            hidden={initialLocation.id !== primaryLocationId}
            data-location-primary-badge
          >
            Base en Villahermosa
          </span>

          <span class="location-explorer__eyebrow">Estado seleccionado</span>
        </div>

        <h3 class="location-explorer__title" data-location-title>
          {initialLocation.displayName}
        </h3>

        <p class="location-explorer__address" data-location-address>
          {initialLocation.addressDisplay}
        </p>

        <div class="location-explorer__info">
          <p class="location-explorer__info-row">
            <Icon name="calendar" size="small" strokeWidth={2} />

            <span>Atención por acuerdo previo</span>
          </p>

          <p class="location-explorer__info-row">
            <Icon name="clock" size="small" strokeWidth={2} />

            <span>Modalidad sujeta al tipo de gestión</span>
          </p>
        </div>

        <div class="location-explorer__divider" aria-hidden="true"></div>

        <p class="location-explorer__helper">
          Selecciona otra opción para conocer cómo iniciar la conversación.
        </p>

        <div class="location-explorer__actions">
          <a
            class="location-explorer__action
            location-explorer__action--whatsapp"
            href={createLocationWhatsAppHref(initialLocation.area)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Consultar sobre ${initialLocation.area} por WhatsApp (se abre en una pestaña nueva)`}
            data-location-whatsapp-link
          >
            <span class="location-explorer__label--short">Consultar</span>
            <span class="location-explorer__label--long">
              Consultar por WhatsApp
            </span>
          </a>

          <a
            class="location-explorer__action
            location-explorer__action--map"
            href={initialLocation.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver ${initialLocation.displayName} en Google Maps (se abre en una pestaña nueva)`}
            data-location-map-link
          >
            <span class="location-explorer__label--short">Ver mapa</span>
            <span class="location-explorer__label--long">
              Abrir en Google Maps
            </span>
          </a>
        </div>

        <p class="location-explorer__confirmation">
          Confirma el lugar y la modalidad directamente por WhatsApp.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initializeLocationExplorers } from '@scripts/location-explorer';

  initializeLocationExplorers();

  document.addEventListener('astro:page-load', initializeLocationExplorers);
</script>

<style>
  .location-explorer {
    width: min(100%, 22.375rem);
    margin-inline: auto;
    font-family: var(--font-family-body);
  }

  .location-explorer__tabs {
    display: flex;
    width: max-content;
    max-width: 100%;
    padding-inline: 0.625rem;
    align-items: flex-end;
  }

  .location-explorer__tab {
    width: 4.6875rem;
    height: 3rem;
    flex: none;
    padding: var(--spacing-2);
    border: 0;
    border-radius: var(--radius-md);
    color: rgb(255 255 255 / 80%);
    background-color: var(--color-action-primary-hover);
    font: inherit;
    font-size: var(--font-size-caption);
    line-height: var(--line-height-caption);
    letter-spacing: var(--letter-spacing-caption);
    text-align: center;
    cursor: pointer;
    transition:
      color var(--motion-duration-fast),
      background-color var(--motion-duration-fast);
  }

  .location-explorer__tab:hover {
    color: var(--color-text-inverse);
  }

  .location-explorer__tab--active,
  .location-explorer__tab[aria-selected='true'] {
    color: var(--color-text-inverse);
    background-color: var(--color-action-secondary);
  }

  .location-explorer__tab:focus-visible,
  .location-explorer__action:focus-visible {
    position: relative;
    z-index: 2;
    outline: var(--focus-ring-width) solid var(--color-border-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .location-explorer__card {
    overflow: hidden;
    border-radius: var(--radius-md);
    color: var(--color-text-inverse);
    background-color: var(--color-background-strong);
  }

  .location-explorer__map {
    width: 100%;
    height: 10.625rem;
    overflow: hidden;
    background-color: var(--color-background-brand-subtle);
  }

  .location-explorer__map-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .location-explorer__details {
    display: flex;
    width: 100%;
    height: 11.4375rem;
    padding: 0.625rem;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.625rem;
  }

  .location-explorer__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3125rem;
  }

  .location-explorer__badge {
    min-height: 1.25rem;
    padding-inline: 0.625rem;
    border-radius: var(--radius-md);
    color: var(--color-text-link);
