    font-size: var(--font-size-label);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-label);
    letter-spacing: var(--letter-spacing-label);
    white-space: nowrap;
  }

  .location-explorer__badge[hidden] {
    display: none;
  }

  .location-explorer__title {
    margin: 0;
    color: var(--color-text-inverse);
    font-family: var(--font-family-body);
    font-size: var(--font-size-heading-4-mobile);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading-4-mobile);
  }

  .location-explorer__address,
  .location-explorer__availability {
    margin: 0;
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-body-small);
  }

  .location-explorer__availability {
    color: rgb(255 255 255 / 75%);
  }

  .location-explorer__actions {
    display: grid;
    width: 100%;
    grid-template-columns:
      minmax(0, 8.1875rem)
      minmax(0, 8.125rem);
    justify-content: center;
    gap: 0.5625rem;
  }

  .location-explorer__action {
    display: inline-flex;
    min-width: 0;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-2);
    padding-inline: var(--spacing-3);
    border-radius: var(--radius-md);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-label);
    letter-spacing: var(--letter-spacing-label);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--motion-duration-fast),
      background-color var(--motion-duration-fast);
  }

  .location-explorer__action:hover {
    transform: translateY(-1px);
  }

  .location-explorer__action--whatsapp {
    color: var(--color-text-on-coral);
    font-weight: var(--font-weight-bold);
    background-color: var(--color-action-whatsapp);
  }

  .location-explorer__whatsapp-icon {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    place-items: center;
  }

  .location-explorer__action--map {
    color: var(--color-text-link);
    background-color: var(--color-background-canvas);
  }

  @media (max-width: 20rem) {
    .location-explorer__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .location-explorer__action {
      padding-inline: var(--spacing-2);
    }
  }

  @media (min-width: 48rem) {
    .location-explorer {
      width: min(100%, 44rem);
    }

    .location-explorer__tabs {
      display: grid;
      width: 100%;
      padding-inline: 0;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .location-explorer__tab {
      width: auto;
      height: 3.25rem;
      font-size: var(--font-size-body-base);
      line-height: var(--line-height-body-base);
    }

    .location-explorer__map {
      height: 17.5rem;
    }

    .location-explorer__details {
      height: 12rem;
      padding: var(--spacing-6);
    }

    .location-explorer__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 75rem) {
    .location-explorer {
      width: min(100%, 75rem);
    }

    .location-explorer__card {
      display: grid;
      height: auto;
      min-height: 33rem;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: var(--spacing-8);
      align-items: center;
    }

    .location-explorer__map {
      width: 100%;
      height: 21.25rem;
    }

    .location-explorer__details {
      width: 100%;
      height: auto;
      min-height: 30rem;
      padding: var(--spacing-6);
      justify-content: center;
    }

    .location-explorer__actions {
      margin-block-start: var(--spacing-1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .location-explorer__tab,
    .location-explorer__action {
      transition: none;
