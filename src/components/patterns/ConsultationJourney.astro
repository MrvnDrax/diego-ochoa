---
import { Image } from 'astro:assets';
import consultorio from '@assets/diego/property-consultation.png';
import { generalWhatsAppHref } from '@data/whatsapp-messages';
import Icon from '@components/ui/Icon.astro';
const steps = [
  {
    icon: 'message-circle' as const,
    title: 'Hablemos de tu proyecto',
    text: 'Entendemos qué quieres hacer y qué información tienes del inmueble.',
  },
  {
    icon: 'stethoscope' as const,
    title: 'Entiende tus opciones',
    text: 'Revisamos documentos y requisitos para ubicar opciones que podrían aplicar.',
  },
  {
    icon: 'file-text' as const,
    title: 'Define tu siguiente paso',
    text: 'Aclara pendientes y conoce las etapas que siguen en tu gestión.',
  },
];
---

<section
  class="consultation"
  id="tu-consulta"
  aria-labelledby="consultation-heading"
>
  <div class="container">
    <header class="consultation__header">
      <div>
        <p class="consultation__eyebrow">Así comienza tu gestión</p>
        <h2 id="consultation-heading">Una conversación que te dé claridad.</h2>
      </div>
      <p>
        Tiempo para entender tu objetivo, revisar el contexto y resolver tus dudas.
      </p>
    </header>
    <div class="consultation__layout">
      <figure>
        <div class="consultation__photo">
          <Image
            src={consultorio}
            alt="Conversación sobre una operación inmobiliaria"
            loading="lazy"
            widths={[440, 740, 1100]}
            sizes="(max-width:767px) 92vw, 43vw"
          />
        </div>
        <figcaption>Orientación en Tabasco, Chiapas y Veracruz.</figcaption>
      </figure>
      <div class="consultation__content">
        <ul>
          {steps.map((step) => (
            <li>
              <Icon name={step.icon} size="medium" strokeWidth={1.5} />
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ul>
        <a
          class="consultation__booking"
          href={generalWhatsAppHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          Consultar mi caso
        </a>
      </div>
    </div>
  </div>
</section>
<style>
  .consultation {
    border-radius: var(--radius-xl);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    background: #e9f2f9;
    color: #1b325f;
  }
  .consultation__header {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.5rem;
    align-items: end;
  }
  .consultation__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #37648c;
  }
  h2 {
    font-size: clamp(2rem, 3vw, 2.9rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 500;
    max-width: 32rem;
  }
  .consultation__header > p {
    font-size: 1rem;
    line-height: 1.7;
    color: #53677d;
    max-width: 29rem;
  }
  .consultation__layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  .consultation__photo {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: var(--radius-xl);
  }
  .consultation__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 52%;
  }
  figcaption {
    font-size: 0.875rem;
    line-height: 1.5;
    color: #53677d;
    padding-top: 0.8rem;
  }
  .consultation__content {
    min-width: 0;
    display: grid;
    gap: 1.5rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.75rem;
  }
  li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }
  li :global(svg) {
    margin-top: 0.15rem;
    color: #37648c;
  }
  h3 {
    font-family: var(--font-family-body);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
  }
  li p {
    font-size: 1rem;
    line-height: 1.65;
    margin-top: 0.5rem;
    color: #53677d;
    max-width: 33rem;
  }
  .consultation__booking {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    min-height: 3.25rem;
    padding: 0.85rem 1.25rem;
    width: fit-content;
    color: var(--color-text-on-coral);
    background: var(--color-action-whatsapp);
    border-radius: var(--radius-md);
    font-weight: 700;
    text-decoration: none;
  }
  .consultation__booking:hover {
    background: var(--color-action-whatsapp-hover);
  }
  @media (min-width: 48rem) {
    .consultation__header,
    .consultation__layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2rem, 4vw, 3rem);
    }
    .consultation__content {
      min-height: 100%;
      align-content: space-between;
    }
    ul {
      gap: 1.75rem;
    }
  }
  @media (max-width: 47.99rem) {
    .consultation__header {
      margin-bottom: 1.75rem;
    }
    .consultation__booking {
      width: 100%;
    }
  }
</style>
