---
import CredentialCard from '@components/cards/CredentialCard.astro';
import ContentSection from '@components/patterns/ContentSection.astro';

import { locations } from '@data/locations';

type CredentialIcon =
  'route' | 'file-text' | 'map-pin';

interface CredentialItem {
  title: string;
  value: string | string[];
  icon: CredentialIcon;
}

interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  description?: string;
  items?: CredentialItem[];
  class?: string;
}

const defaultItems: CredentialItem[] = [
  {
    title: 'Enfoque',
    value: 'Gestiones inmobiliarias',
    icon: 'route',
  },
  {
    title: 'Atención',
    value: 'Tabasco, Chiapas y Veracruz',
    icon: 'map-pin',
  },
  {
    title: 'Proceso',
    value: ['Escuchar tu objetivo', 'Revisar documentos', 'Explicar los pasos'],
    icon: 'file-text',
  },
  {
    title: 'Modalidad',
    value: locations.map((location) => location.displayName),
    icon: 'map-pin',
  },
];

const {
  id = 'credenciales',
  eyebrow = 'Cómo trabajamos',
  heading = 'Claridad en cada etapa',
  description,
  items = defaultItems,
  class: className,
}: Props = Astro.props;
---

<ContentSection
  id={id}
  class:list={['professional-credentials', className]}
  eyebrow={eyebrow}
  heading={heading}
  description={description}
  descriptionSize="base"
  align="center"
  eyebrowAlign="center"
  tone="subtle"
  spacing="default"
  shape="editorial"
  layout="stack"
>
  <div class="professional-credentials__grid">
    {items.map((item) => (
      <CredentialCard title={item.title} value={item.value} icon={item.icon} />
    ))}
  </div>
</ContentSection>

<style>
  .professional-credentials__grid {
    display: grid;
    width: 100%;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 1fr;
    gap: var(--spacing-3);
  }

  @media (min-width: 48rem) {
    .professional-credentials__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-6);
    }
  }

  @media (min-width: 75rem) {
    .professional-credentials__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
