---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import Icon from '@components/ui/Icon.astro';
import { createWhatsAppHref } from '@data/whatsapp-messages';
import CtaSection from '@components/patterns/CtaSection.astro';
import Button from '@components/ui/Button.astro';
import Container from '@components/ui/Container.astro';
import Section from '@components/ui/Section.astro';
import { getServiceEducation } from '@data/service-education';
import { getServiceVisual } from '@data/service-visuals';
import { createServiceSchema } from '@data/structured-data';
import SiteLayout from '@layouts/SiteLayout.astro';

interface Props {
  service: CollectionEntry<'services'>;
}

const { service }: Props = Astro.props;
const visual = getServiceVisual(service.data.media.key, service.data.media.alt);
const canonicalPath = `/servicios/${service.id}/`;
const appointmentHref = createWhatsAppHref(
  `Hola, Diego. Quiero consultar sobre ${service.data.card.title}.`,
);
const serviceSchema = createServiceSchema({
  slug: service.id,
  name: service.data.page.hero.title,
  description: service.data.page.hero.description,
  category: service.data.page.category,
});
---

<SiteLayout
  title={service.data.page.hero.title + ' | Diego Ochoa'}
  description={service.data.card.summary}
  canonicalPath={canonicalPath}
  pageType={['WebPage']}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Servicios', path: '/servicios' },
    { name: service.data.page.hero.title, path: canonicalPath },
  ]}
  mainEntity={{ '@id': String(serviceSchema['@id']) }}
  structuredData={[serviceSchema]}
>
  <Section
    tone="brand-subtle"
    spacing="large"
    class="service-detail-page__hero"
  >
    <Container>
      <div class="service-detail-page__split">
        <div class="service-detail-page__copy">
          <p class="service-detail-page__eyebrow">
            {service.data.page.category}
          </p>
          <h1>{service.data.page.hero.title}</h1>
          <p class="service-detail-page__lead">
            {service.data.page.hero.description}
          </p>
          <div class="service-detail-page__actions">
            <Button
              href={appointmentHref}
              target="_blank"
              ariaLabel={
                'Consultar sobre ' + service.data.card.title
              }
            >
              Consultar mi caso
            </Button>
            <a class="service-detail-page__learn" href="#cuando-consultar">
              Conoce cuándo iniciar
            </a>
          </div>
          <p class="service-detail-page__appointment-note">
            Diego Ochoa · Gestiones inmobiliarias
          </p>
        </div>
        <figure class="service-detail-page__hero-visual">
          <Image
            class="service-detail-page__hero-image"
            src={visual.hero.image}
            alt={visual.hero.alt}
            loading="eager"
          />
          <figcaption>
            <span>Orientación inmobiliaria</span>El proceso empieza por entender tu caso.
          </figcaption>
        </figure>
      </div>
    </Container>
  </Section>

  <nav
    class="service-detail-page__contents"
    aria-label="Contenido de esta página"
  >
    <Container>
      <div class="service-detail-page__contents-inner">
        <a href="/servicios/">← Todos los servicios</a>
        <div>
          <a href="#cuando-consultar">Cuándo iniciar</a>
          {service.data.page.sections.map((section, index) => (
            <a href={'#informacion-' + (index + 1)}>{section.eyebrow}</a>
          ))}
        </div>
      </div>
    </Container>
  </nav>

  <Section
    id="cuando-consultar"
    tone="canvas"
    spacing="default"
    class="service-detail-page__signals-section"
  >
    <Container>
      <header class="service-detail-page__section-header">
        <p class="service-detail-page__eyebrow">Cu&aacute;ndo iniciar</p>
        <h2>Aspectos que conviene revisar</h2>
      </header>
      <div class="service-detail-page__signals">
        {service.data.page.signals.map((signal) => (
          <article class="service-detail-page__signal">
            <Icon name={signal.icon} size="medium" />
            <h3>{signal.title}</h3>
            <p>{signal.description}</p>
          </article>
        ))}
      </div>
    </Container>
  </Section>

  {service.data.page.sections.map((section, index) => {
    const sectionVisual = visual.sections[index];
    const education = !sectionVisual
      ? getServiceEducation(service.data.media.key, index)
      : undefined;

    return (
      <Section
        id={'informacion-' + (index + 1)}
        tone={section.tone}
        spacing="default"
        class:list={[
          'service-detail-page__editorial',
          index % 2 === 1 && 'service-detail-page__editorial--reverse',
        ]}
      >
        <Container>
          <div class="service-detail-page__split">
            <div class="service-detail-page__copy">
              <p class="service-detail-page__eyebrow">{section.eyebrow}</p>
              <h2>{section.heading}</h2>
              <p class="service-detail-page__description">
                {section.description}
              </p>
            </div>
            {sectionVisual ? (
              <Image
                class="service-detail-page__section-image"
                src={sectionVisual.image}
                alt={sectionVisual.alt}
                loading="lazy"
              />
            ) : education ? (
              <aside
                class="service-detail-page__education"
                aria-label={'Información educativa: ' + education.title}
              >
                <h3>{education.title}</h3>
                <p>{education.intro}</p>
                <ul>
                  {education.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </aside>
            ) : null}
          </div>
        </Container>
      </Section>
    );
  })}

  <CtaSection
    heading={service.data.page.cta.heading}
    description={service.data.page.cta.description}
  />
</SiteLayout>

<style>
  :global(.service-detail-page__hero.section--brand-subtle) {
    --color-text-primary: #1b325f;
    --color-text-secondary: #46576e;
    --color-text-brand: #1b325f;
    background: #e9f2f9;
    border-bottom: 1px solid #c8d7e6;
    border-radius: var(--radius-xl);
  }
  .service-detail-page__split {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .service-detail-page__copy {
    display: grid;
    gap: 1.25rem;
    max-width: 41rem;
  }
  .service-detail-page__eyebrow {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    color: var(--color-text-brand);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .service-detail-page__copy h1,
  .service-detail-page__copy h2,
  .service-detail-page__section-header h2,
  .service-detail-page__education h3 {
    margin: 0;
    font-family: var(--font-family-heading);
    color: var(--color-text-primary);
  }
  .service-detail-page__copy h1 {
    color: #1b325f;
    font-size: clamp(2.4rem, 4.4vw, 4rem);
    line-height: 1.07;
    letter-spacing: -0.035em;
  }
  .service-detail-page__copy h2,
  .service-detail-page__section-header h2 {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .service-detail-page__lead,
  .service-detail-page__description {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .service-detail-page__actions {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .service-detail-page__learn {
    color: #1b325f;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }
  .service-detail-page__learn:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .service-detail-page__appointment-note {
    margin: 0.25rem 0 0;
    color: #52647c;
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .service-detail-page__hero-visual {
    margin: 0;
    position: relative;
  }
  .service-detail-page__hero-image,
  .service-detail-page__section-image {
    display: block;
    width: 100%;
    border-radius: var(--radius-md);
    object-fit: cover;
  }
  .service-detail-page__hero-image {
    height: clamp(17rem, 48vw, 30rem);
  }
  .service-detail-page__hero-visual figcaption {
    display: grid;
    gap: 0.3rem;
    padding: 1.25rem;
    border-left: 3px solid #f26c4f;
    background: #1b325f;
    color: #fff;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .service-detail-page__hero-visual figcaption span {
    color: #9cc4e4;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    text-transform: uppercase;
  }
  .service-detail-page__section-image {
    height: clamp(16rem, 35vw, 27rem);
  }
  .service-detail-page__contents {
    background: #fff;
    border-bottom: 1px solid #d7e1ec;
  }
  .service-detail-page__contents-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-block: 0.75rem;
  }
  .service-detail-page__contents-inner > a {
    padding-block: 0.5rem;
    color: #1b325f;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .service-detail-page__contents-inner > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.25rem;
  }
  .service-detail-page__contents-inner > div a {
    padding-block: 0.5rem;
    color: #46576e;
    font-size: 0.78rem;
    text-decoration: none;
  }
  .service-detail-page__contents a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .service-detail-page__section-header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .service-detail-page__signals {
    display: grid;
    gap: 1.5rem;
  }
  .service-detail-page__signal {
    padding: 1.5rem 0 0;
    border-top: 2px solid #9cc4e4;
  }
  .service-detail-page__signal > :global(.icon) {
    color: #1b325f;
    margin-bottom: 1rem;
  }
  .service-detail-page__signal h3 {
    margin: 0;
    color: #1b325f;
    font-family: var(--font-family-heading);
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .service-detail-page__signal p {
    color: #46576e;
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    line-height: 1.65;
  }
  :global(.service-detail-page__editorial) {
    border-radius: var(--radius-xl);
    border-top: 1px solid #d7e1ec;
    scroll-margin-top: 6rem;
  }
  .service-detail-page__education {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid #c8d7e6;
    border-top: 3px solid #1b325f;
    border-radius: var(--radius-md);
    background: #fff;
  }
  .service-detail-page__education h3 {
    font-size: 1.5rem;
    line-height: 1.25;
  }
  .service-detail-page__education p,
  .service-detail-page__education ul {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .service-detail-page__education ul {
    display: grid;
    gap: 0.65rem;
    padding-left: 1.2rem;
  }
  .service-detail-page__education li::marker {
    color: #b74930;
  }
  :global(.service-detail-page__editorial.section--strong) {
    --color-text-primary: #fff;
    --color-text-secondary: #d6e2ef;
    --color-text-brand: #9cc4e4;
  }
  :global(.service-detail-page__editorial.section--strong)
    .service-detail-page__education {
    border-color: #506585;
    border-top-color: #f26c4f;
    background: rgb(255 255 255 / 6%);
  }
  :global(.service-detail-page__editorial.section--strong)
    .service-detail-page__education
    li::marker {
    color: #f7a18b;
  }
  @media (min-width: 48rem) {
    .service-detail-page__signals {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
    .service-detail-page__split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
    :global(
        .service-detail-page__editorial--reverse .service-detail-page__split
      )
      > :first-child {
      order: 2;
    }
    :global(
        .service-detail-page__editorial--reverse .service-detail-page__split
      )
      > :last-child {
      order: 1;
    }
  }
  @media (min-width: 75rem) {
    .service-detail-page__signals {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .service-detail-page__split {
      gap: 4rem;
    }
    .service-detail-page__actions {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
  }
</style>
