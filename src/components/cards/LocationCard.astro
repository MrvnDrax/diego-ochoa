---
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';

import type { ClinicLocation } from '@data/locations';
import { primaryLocationId } from '@data/locations';
import { createLocationWhatsAppHref } from '@data/whatsapp-messages';

interface Props {
  location: ClinicLocation;
}

const { location }: Props = Astro.props;

const isPrimary = location.id === primaryLocationId;

const locationTitle = location.facilityName
  ? `${location.facilityName} · ${location.area}`
  : location.area;

const locationDetails = [location.address, location.office].filter(
  (value): value is string => Boolean(value),
);

const whatsappHref = createLocationWhatsAppHref(location.area);
---

<article class="location-card">
  <div class="location-card__content">
    <div class="location-card__eyebrow">
      <Icon name={'map-pin'} size="small" />

      <span>{isPrimary ? 'Base en Villahermosa' : 'Zona de gestión'}</span>
    </div>

    <h3 class="location-card__title">{locationTitle}</h3>

    {locationDetails.length > 0 && (
      <p class="location-card__address">{locationDetails.join(' · ')}</p>
    )}

    <div class="location-card__actions">
      <div class="location-card__action">
        <Button
          href={whatsappHref}
          variant="whatsapp"
          target="_blank"
          rel="noopener noreferrer"
        >
          Consultar
        </Button>
      </div>

      <div
        class="location-card__action
          location-card__action--map"
      >
        <Button
          href={location.mapUrl}
          variant="ghost"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver mapa
        </Button>
      </div>
    </div>
  </div>
</article>

<style>
  .location-card {
    --color-text-primary: var(--color-brand-clinical-950);
    --color-text-secondary: var(--color-brand-clinical-600);
    --color-text-brand: var(--color-brand-clinical-950);
    --color-text-link: var(--color-brand-clinical-600);
    --color-border-default: var(--color-brand-clinical-200);

    display: flex;
    width: 100%;
    min-height: 14.75rem;
    padding: 1.125rem;
    overflow: hidden;
    border: 1px solid var(--color-text-brand);
    border-radius: var(--radius-lg);
    background-color: var(--color-background-brand-subtle);
  }

  .location-card__content {
    display: flex;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    gap: 0.5625rem;
  }

  .location-card__eyebrow {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.625rem;
    color: var(--color-text-brand);
    font-family: var(--font-family-base);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.125rem;
    text-transform: uppercase;
  }

  .location-card__title {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-family-display);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 2rem;
  }

  .location-card__address {
    margin: 0;
    color: var(--color-text-secondary);
    font-family: var(--font-family-base);
    font-size: 1rem;
    line-height: 1.5625rem;
  }

  .location-card__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5625rem;
    margin-block-start: auto;
    padding-block-start: var(--spacing-2);
  }

  .location-card__action {
    width: 8.1875rem;
    max-width: 100%;
  }

  .location-card__action :global(.button) {
    width: 100%;
    min-width: 0;
    height: 2.25rem;
    padding-inline: var(--spacing-3);
  }

  .location-card__action--map :global(.button) {
    color: var(--color-text-link);
    background-color: var(--color-background-canvas);
  }

  @media (min-width: 40rem) {
    .location-card {
      height: 100%;
    }
  }
</style>
