---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Icon from '@components/ui/Icon.astro';

interface Props {
  index?: number;
  title: string;
  summary: string;
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  priority?: boolean;
}

const {
  index = 1,
  title,
  summary,
  href,
  image,
  imageAlt,
  priority = false,
}: Props = Astro.props;

const numberLabel = String(index).padStart(2, '0');
---

<article class="service-card">
  <a
    class="service-card__link"
    href={href}
    aria-label={`Conocer el servicio de ${title}`}
  >
    <div class="service-card__media">
      <Image
        class="service-card__image"
        src={image}
        alt={imageAlt}
        loading={priority ? 'eager' : 'lazy'}
      />
    </div>

    <div class="service-card__body">
      <div class="service-card__meta" aria-hidden="true">
        <span class="service-card__number">{numberLabel}</span>

        <span class="service-card__rule"></span>
      </div>

      <h3 class="service-card__title">{title}</h3>

      <div class="service-card__details">
        <p class="service-card__summary">{summary}</p>

        <span class="service-card__action" aria-hidden="true">
          <Icon name="arrow-right" size="medium" />
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .service-card,
  .service-card__link {
    --color-text-primary: var(--color-brand-clinical-950);
    --color-text-secondary: var(--color-brand-clinical-600);
    --color-text-brand: var(--color-brand-clinical-950);
    --color-text-link: var(--color-brand-clinical-600);
    --color-border-default: var(--color-brand-clinical-200);

    width: 100%;
    height: 100%;
  }

  .service-card__link {
    display: flex;
    min-height: 21.25rem;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-lg);
    color: var(--color-text-primary);
    background-color: var(--color-background-canvas);
    box-shadow: var(--shadow-subtle);
    text-decoration: none;
  }

  .service-card__media {
    width: 100%;
    height: 11.125rem;
    flex: none;
    overflow: hidden;
    background-color: var(--color-background-brand-subtle);
  }

  .service-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-duration-standard) ease;
  }

  .service-card__body {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    gap: var(--spacing-2);
    padding: var(--spacing-4) var(--spacing-4) 1.125rem;
  }

  .service-card__meta {
    display: flex;
    min-height: 1.125rem;
    align-items: center;
    gap: 0.625rem;
  }

  .service-card__number {
    color: var(--color-text-brand);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-semibold);
    line-height: 1.125rem;
  }

  .service-card__rule {
    width: 3rem;
    height: 1px;
    background-color: var(--color-text-brand);
  }

  .service-card__title {
    margin: 0;
    color: var(--color-text-brand);
    font-family: var(--font-family-heading);
    font-size: 1.375rem;
    font-weight: var(--font-weight-semibold);
    line-height: 1.75rem;
    letter-spacing: -0.00625rem;
  }

  .service-card__details {
    display: flex;
    min-height: 0;
    flex: 1;
    align-items: flex-end;
    gap: var(--spacing-3);
  }

  .service-card__summary {
    min-width: 0;
    flex: 1;
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-body-small);
  }

  .service-card__action {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: var(--radius-full);
    color: var(--color-text-brand);
    background-color: var(--color-background-brand-subtle);
    place-items: center;
    transition:
      color var(--motion-duration-fast),
      background-color var(--motion-duration-fast),
      transform var(--motion-duration-fast);
  }

  .service-card__link:hover .service-card__image,
  .service-card__link:focus-visible .service-card__image {
    transform: scale(1.025);
  }

  .service-card__link:hover .service-card__action,
  .service-card__link:focus-visible .service-card__action {
    color: var(--color-text-inverse);
    background-color: var(--color-action-secondary);
    transform: translateX(0.125rem);
  }

  @media (min-width: 48rem) {
    .service-card__link {
      min-height: 20.75rem;
    }

    .service-card__media {
      height: 10.625rem;
    }
  }

  @media (min-width: 75rem) {
    .service-card__link {
      min-height: 22.25rem;
    }

    .service-card__media {
      height: 11.875rem;
    }

    .service-card__body {
      padding-inline: var(--spacing-5);
    }

    .service-card__title {
      font-size: var(--font-size-heading-4-desktop);
      line-height: 1.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card__image,
    .service-card__action {
      transition: none;
    }
  }
</style>
