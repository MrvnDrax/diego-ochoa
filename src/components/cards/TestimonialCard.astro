---
import { doctoraliaProfile } from '@data/booking';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  quote: string;
  rating: number;
  author: string;
  portrait: ImageMetadata;
  publishedAt: string;
  location: string;
  sourceHref?: string;
  verifiedLabel?: string;
  featured?: boolean;
  class?: string;
}
const {
  quote,
  rating,
  author,
  portrait,
  publishedAt,
  location,
  sourceHref = doctoraliaProfile.href,
  verifiedLabel,
  class: className,
}: Props = Astro.props;
---

<article class:list={['testimonial-card', className]}>
  <header class="testimonial-card__header">
    <span class="testimonial-card__portrait">
      <Image
        src={portrait}
        alt=""
        width={88}
        height={88}
        widths={[88, 176]}
        sizes="44px"
        loading="lazy"
      />
    </span>
    <div>
      <h3>{author}</h3>
      <p>{location}</p>
      <span class="testimonial-card__portrait-note">Imagen ilustrativa</span>
    </div>
    <span class="testimonial-card__context">{publishedAt}</span>
  </header>
  <div
    class="testimonial-card__rating"
    aria-hidden="true"
  >
    {Array.from({ length: 5 }, (_, index) => (
      <span
        class:list={[
          'testimonial-card__star',
          index < rating && 'testimonial-card__star--filled',
        ]}
        aria-hidden="true"
      >
        •
      </span>
    ))}
  </div>
  <blockquote>{quote}</blockquote>
  <footer>
    <a
      href={sourceHref}
      
      aria-label={`Conocer servicios relacionados con ${author}`}
    >
      Explorar servicios
    </a>
    {verifiedLabel && <span>{verifiedLabel}</span>}
  </footer>
</article>
<style>
  .testimonial-card {
    padding-block: 1.75rem;
    min-width: 0;
    color: #1b325f;
  }
  .testimonial-card__header {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.25rem 0.8rem;
    align-items: center;
  }
  .testimonial-card__portrait {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    overflow: hidden;
    background: #e9f2f9;
    border: 1px solid #d5e2ec;
    grid-row: 1/3;
  }
  .testimonial-card__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h3 {
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.45;
    font-weight: 600;
    margin: 0;
  }
  .testimonial-card__header p {
    font-size: 0.875rem;
    line-height: 1.45;
    color: #53677d;
  }
  .testimonial-card__portrait-note {
    display: block;
    margin-top: 0.15rem;
    color: #718298;
    font-size: 0.6875rem;
    line-height: 1.35;
  }
  .testimonial-card__context {
    grid-column: 2;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #53677d;
  }
  .testimonial-card__rating {
    display: flex;
    gap: 0.18rem;
    margin-top: 1.15rem;
    color: #b8c6d2;
    font-size: 1.15rem;
    line-height: 1;
  }
  .testimonial-card__star--filled {
    color: #d9872f;
  }
  blockquote {
    margin: 1rem 0;
    font-family: var(--font-family-body);
    font-size: 1.125rem;
    line-height: 1.7;
    font-weight: 400;
    letter-spacing: 0;
  }
  footer {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    color: #53677d;
    font-size: 0.875rem;
  }
  footer a {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    text-underline-offset: 0.25em;
    min-height: 1.75rem;
    color: #37648c;
  }
  @media (min-width: 75rem) {
    .testimonial-card__header {
      grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    }
    .testimonial-card__portrait {
      grid-row: auto;
    }
    .testimonial-card__context {
      grid-column: auto;
      text-align: right;
      max-width: 9rem;
    }
  }
</style>
