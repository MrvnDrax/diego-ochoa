---
import Icon from '@components/ui/Icon.astro';

type CredentialIcon =
  | 'accessibility'
  | 'activity'
  | 'bandage'
  | 'biceps-flexed'
  | 'bone-fracture'
  | 'expand'
  | 'file-text'
  | 'footprints'
  | 'graduation-cap'
  | 'lock-keyhole'
  | 'map-pin'
  | 'move-3d'
  | 'rotate-ccw'
  | 'route'
  | 'shield-alert'
  | 'stethoscope'
  | 'timer-reset'
  | 'trending-down';

interface Props {
  title: string;
  value: string | string[];
  icon: CredentialIcon;
  class?: string;
}

const { title, value, icon, class: className, ...rest }: Props = Astro.props;
---

<article class:list={['credential-card', className]} {...rest}>
  <span class="credential-card__icon" aria-hidden="true">
    <Icon name={icon} size="xlarge" strokeWidth={2.25} />
  </span>

  <div class="credential-card__content">
    <h3 class="credential-card__title">{title}</h3>

    {Array.isArray(value) ? (
      <div class="credential-card__value credential-card__value--list">
        {value.map((line) => (
          <p>{line}</p>
        ))}
      </div>
    ) : (
      <p class="credential-card__value">{value}</p>
    )}
  </div>
</article>

<style>
  .credential-card {
    --color-text-primary: var(--color-brand-clinical-950);
    --color-text-secondary: var(--color-brand-clinical-600);
    --color-text-brand: var(--color-brand-clinical-950);
    --color-text-link: var(--color-brand-clinical-600);
    --color-border-default: var(--color-brand-clinical-200);

    display: flex;
    width: 100%;
    min-width: 0;
    min-height: 6.875rem;
    align-items: center;
    justify-content: center;
    flex-direction: row-reverse;
    gap: var(--spacing-2);
    padding: var(--spacing-4);
    overflow: hidden;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    color: var(--color-text-primary);
    background-color: var(--color-background-canvas);
  }

  .credential-card__icon {
    display: grid;
    width: 4.5rem;
    height: 4.5rem;
    flex: none;
    border-radius: var(--radius-full);
    color: var(--color-text-primary);
    background-color: var(--color-background-brand-subtle);
    place-items: center;
  }

  .credential-card__content {
    display: grid;
    min-width: 0;
    flex: 1;
    gap: var(--spacing-2);
    text-align: center;
  }

  .credential-card__title,
  .credential-card__value,
  .credential-card__value p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .credential-card__title {
    color: var(--color-text-brand);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-bold);
    line-height: 1.375rem;
  }

  .credential-card__value {
    color: var(--color-text-primary);
    font-size: var(--font-size-body-base);
    line-height: var(--line-height-body-base);
  }

  .credential-card__value--list {
    display: grid;
    gap: var(--spacing-1);
  }

  @media (max-width: 23rem) {
    .credential-card {
      padding: var(--spacing-3);
    }

    .credential-card__icon {
      width: 4rem;
      height: 4rem;
    }
  }

  @media (min-width: 75rem) {
    .credential-card {
      min-height: 8.375rem;
      padding: var(--spacing-4);
    }

    .credential-card__content {
      max-width: 10.625rem;
    }
  }
</style>
