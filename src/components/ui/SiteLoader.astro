---
import logoMark from '@assets/brand/logo-mark-color.svg';
---

<div class="site-loader" data-site-loader role="status" aria-live="polite">
  <div class="site-loader__content">
    <img src={logoMark.src} width="72" height="72" alt="" aria-hidden="true" />
    <p class="site-loader__name">Diego Ochoa</p>
    <p class="site-loader__specialty">Gestiones inmobiliarias</p>
    <span class="site-loader__track" aria-hidden="true">
      <span></span>
    </span>
    <span class="site-loader__message">Preparando el sitio…</span>
  </div>
</div>

<style>
  :global(html[data-site-loading]) {
    overflow: hidden;
  }

  :global(html[data-site-loading] body > :not(.site-loader)) {
    visibility: hidden;
  }

  .site-loader {
    position: fixed;
    z-index: 10000;
    inset: 0;
    display: grid;
    padding: 1.5rem;
    background: #f7fafc;
    color: #1b325f;
    place-items: center;
    transition:
      opacity 260ms ease-out,
      visibility 260ms ease-out;
  }

  .site-loader--leaving {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .site-loader__content {
    display: grid;
    width: min(17rem, 100%);
    justify-items: center;
    text-align: center;
  }

  .site-loader__content img {
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 0.625rem;
  }

  .site-loader__name {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .site-loader__specialty {
    margin-top: 0.125rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-loader__track {
    width: 8rem;
    height: 0.1875rem;
    margin-block: 1.75rem 0.75rem;
    overflow: hidden;
    border-radius: 999px;
    background: #d8e7f2;
  }

  .site-loader__track > span {
    display: block;
    width: 45%;
    height: 100%;
    border-radius: inherit;
    background: #f26c4f;
    animation: site-loader-progress 1.1s ease-in-out infinite alternate;
  }

  .site-loader__message {
    color: #53677d;
    font-size: 0.875rem;
  }

  @keyframes site-loader-progress {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(285%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-loader,
    .site-loader__track > span {
      animation: none;
      transition: none;
    }
    .site-loader__track > span {
      width: 100%;
    }
  }
</style>
