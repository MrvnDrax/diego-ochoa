---
type EyebrowElement = 'p' | 'span';

type EyebrowTone = 'brand' | 'muted' | 'inverse' | 'warm';

interface Props {
  as?: EyebrowElement;
  tone?: EyebrowTone;
  class?: string;
}

const { as: Tag = 'p', tone = 'brand', class: className }: Props = Astro.props;
---

<Tag class:list={['eyebrow', `eyebrow--${tone}`, className]}>
  <slot />
</Tag>

<style>
  .eyebrow {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--font-size-eyebrow);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-label);
    letter-spacing: var(--letter-spacing-eyebrow);
    text-transform: uppercase;
  }

  .eyebrow--brand {
    color: var(--color-text-brand);
  }

  .eyebrow--muted {
    color: var(--color-text-secondary);
  }

  .eyebrow--inverse {
    color: var(--color-text-inverse);
  }

  .eyebrow--warm {
    color: var(--color-brand-warm-400);
  }
</style>
