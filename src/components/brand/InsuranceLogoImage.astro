---
import Icon from '@components/ui/Icon.astro';
import { insurers, type InsurerId } from '@data/insurers';
interface Props { insurer: InsurerId; label: string; }
const { insurer, label }: Props = Astro.props;
const step = insurers.find((item) => item.id === insurer);
---

<span class="guidance-step">
  <span class="guidance-step__icon" aria-hidden="true">
    <Icon name={step?.icon ?? 'check'} size="medium" />
  </span>
  <span>{label}</span>
</span>

<style>
  .guidance-step {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.55rem;
    color: #1b325f;
    font-size: 0.82rem;
    line-height: 1.25;
    font-weight: 700;
  }
  .guidance-step__icon {
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    border-radius: 50%;
    background: #e9f2f9;
    color: #32628e;
    place-items: center;
  }
  .guidance-step__icon :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
</style>
